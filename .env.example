# Names only. Every variable is parsed once by packages/core/src/env.ts; see documents/public/components/core.md.
FALKORDB_URL=redis://localhost:6379
LLM_PROVIDER=openai
# LLM_MODEL defaults per provider: gpt-5, claude-sonnet-5-5, gemini-3.1-pro-preview
LLM_MODEL=
# Only the selected provider's key is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
PR_TARGET_OWNER=
WORKER_URL=http://localhost:8787
WORKER_TOKEN=
PORT=8787
WEB_ORIGIN=http://localhost:3001
MCP_GRAPH=
MCP_ALLOW_WRITES=false
MCP_HTTP_PORT=
MCP_TOKEN=
SANDBOX_IMAGE=noderunner-sandbox:1
CACHE_DIR=.cache
LOG_LEVEL=info
