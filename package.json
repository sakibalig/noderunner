{
  "name": "noderunner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "format": "biome check --write .",
    "test": "vitest run",
    "triage": "pnpm --silent --filter @noderunner/cli start",
    "eval": "pnpm --silent --filter @noderunner/eval start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
